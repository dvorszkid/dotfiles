##
# PATH dirs
##

# Prepend to PATH only once, so nested shells (tmux, terminals) don't stack duplicates
path_prepend() {
  case ":${PATH}:" in
    *":$1:"*) ;;
    *) PATH="$1:${PATH}" ;;
  esac
  export PATH
}

# FZF
if [ -x "$(command -v fzf)" ]; then
  path_prepend "${HOME}/.fzf/bin"
  if [ -x "$(command -v rg)" ]; then
    export FZF_DEFAULT_COMMAND='rg --files'
  elif [ -x "$(command -v ag)" ]; then
    export FZF_DEFAULT_COMMAND='ag -g ""'
  fi
  export FZF_DEFAULT_OPTS="--style=full"
fi

# Rust
if [ -d "/opt/homebrew/opt/rustup/bin" ]; then
  path_prepend "/opt/homebrew/opt/rustup/bin"
fi
if [ -d "$HOME/.cargo/bin" ]; then
  path_prepend "${HOME}/.cargo/bin"
fi

# Go
if [ -x "$(command -v go)" ]; then
  [ -n "$GOPATH" ] || GOPATH="$(go env GOPATH)" # inherited by nested shells, no subprocess
  export GOPATH
  path_prepend "${GOPATH}/bin"
fi

# Node Version Manager
if [ -d "$HOME/.nvm" ]; then
  export NVM_DIR="$HOME/.nvm"
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"                   # This loads nvm
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion" # This loads nvm bash_completion
fi

# Fast Node Manager
FNM_PATH="$HOME/.local/share/fnm"
if [ -d "$FNM_PATH" ]; then
  path_prepend "$FNM_PATH"
  # Only once per session: every `fnm env` creates a new multishell dir
  [ -n "$FNM_MULTISHELL_PATH" ] || eval "$(fnm env)"
fi

if [ -d "$HOME/.local/share/pnpm" ]; then
  export PNPM_HOME="$HOME/.local/share/pnpm"
  path_prepend "$PNPM_HOME"
fi

if [ -d "$HOME/.gem/ruby/3.3.0/bin" ]; then
  path_prepend "$HOME/.gem/ruby/3.3.0/bin"
fi

if [ -f "/opt/homebrew/bin/brew" ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

if [ -d "/opt/homebrew/opt/llvm/bin" ]; then
  path_prepend "/opt/homebrew/opt/llvm/bin"
fi

if [ -d "/opt/homebrew/opt/qt@5/bin" ]; then
  path_prepend "/opt/homebrew/opt/qt@5/bin"
fi

if [ -d "/opt/homebrew/opt/coreutils/libexec/gnubin" ]; then
  path_prepend "/opt/homebrew/opt/coreutils/libexec/gnubin"
fi

if [ -d "/opt/homebrew/opt/grep/libexec/gnubin" ]; then
  path_prepend "/opt/homebrew/opt/grep/libexec/gnubin"
fi

if [ -d "/opt/homebrew/opt/gnu-sed/libexec/gnubin" ]; then
  path_prepend "/opt/homebrew/opt/gnu-sed/libexec/gnubin"
fi

if [ -d "/opt/homebrew/opt/openjdk/bin" ]; then
  path_prepend "/opt/homebrew/opt/openjdk/bin"
fi

if [ -d "/opt/homebrew/opt/ruby/bin" ]; then
  path_prepend "/opt/homebrew/opt/ruby/bin"
fi

if [ -d "$HOME/.dotnet/tools" ]; then
  path_prepend "$HOME/.dotnet/tools"
fi

# Finally the local bin to be able to override anything
path_prepend "${HOME}/.local/bin"

##
# Strict permissions
#
# Also need to set the following in /etc/sudoers to not make a mess, that's why whitelisting:
#   ## This makes it possible to specify a more permissive umask in sudoers than the user's own umask.
#   Defaults umask_override
##
if [ "${HOST:-${HOSTNAME:-$(hostname)}}" = "basestar" ]; then
  umask 027
fi

##
# Default apps
##
if command -v nvim &>/dev/null; then
  export EDITOR=nvim
else
  export EDITOR=vim
fi

##
# WSL apps
##
if command -v wslview &>/dev/null; then
  # eg. 'webbrowser' python package will use the browser in Windows
  export BROWSER="wslview"
fi

##
# Open in background for MC
##
export MC_XDG_OPEN=$(which mc-xdg-open)

##
# Use Linux config dir on MacOS
##
export XDG_CONFIG_HOME="$HOME/.config"

##
# Colors for ls
##
if [[ $(uname) == "Linux" ]]; then
  eval "$(dircolors "$HOME/.local/share/dircolors/solarized/dircolors.ansi-dark")"
fi

##
# Colors for Man Pages
##
export LESS_TERMCAP_md=$'\E[01;38;5;74m'
export LESS_TERMCAP_us=$'\E[01;36m'

##
# Screensaver settings
##
export XSECURELOCK_SWITCH_USER_COMMAND="dm-tool switch-to-greeter"

##
# Local .env
##
[ -f "$HOME/.env.local" ] && source "$HOME/.env.local"
